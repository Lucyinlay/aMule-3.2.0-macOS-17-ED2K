 #define NORMALITY_FACTOR 2 // <50%
 // x > NORMALITY_FACTOR -> High availability.
 
+// Adds the build owner's startup links once per *profile*, after the download queue
+// is initialized. This is intentionally independent of the GUI, so amuled works.
+// A marker is written only if every link was accepted OR already exists by hash.
+// Failed attempts retry on the next program launch, not every one-second tick.
+static void QueuePreloadedED2KOnce(CDownloadQueue *queue)
+{
+    const wxString markerPath = thePrefs::GetConfigDir() + wxT("preloaded_ed2k_v1.done");
+    if (wxFileExists(markerPath)) {
+        return;
+    }
+
+    unsigned failures = 0;
+    for (unsigned i = 0; i < PreloadedED2K::kLinkCount; ++i) {
+        const wxString uri = wxString::FromUTF8(PreloadedED2K::kLinks[i]);
+        bool alreadyAvailable = false;
+        try {
+            CScopedPtr<CED2KLink> parsed(CED2KLink::CreateLinkFromUrl(uri));
+            if (parsed.get()->GetKind() != CED2KLink::kFile) {
+                ++failures;
+                continue;
+            }
+            const CED2KFileLink *file = static_cast<const CED2KFileLink *>(parsed.get());
+            alreadyAvailable = queue->IsFileExisting(file->GetHashKey(), file->GetName());
+        } catch (const wxString &err) {
+            AddLogLineC(CFormat(wxT("Invalid preloaded eD2k link: %s")) % err);
+            ++failures;
+            continue;
+        }
+
+        if (!alreadyAvailable && !queue->AddLink(uri)) {
+            ++failures;
+        }
+    }
+
+    if (failures != 0) {
+        AddLogLineC(CFormat(wxT("Preloaded eD2k links: %u failed; will retry on next launch.")) % failures);
+        return;
+    }
+
+    wxFile marker;
+    if (!marker.Create(markerPath, false)) {
+        AddLogLineC(wxT("Cannot write preloaded ED2K marker; next launch may retry."));
+        return;
+    }
+    marker.Write(wxT("Initial links processed by this build. Delete this file to add them again.\n"));
+    marker.Close();
+    AddLogLineC(CFormat(wxT("Preloaded eD2k links processed: %u.")) % PreloadedED2K::kLinkCount);
+}
